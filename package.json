{
  "name": "obsidian-agent-skills",
  "version": "0.1.1",
  "description": "Run local agent skills against the active Obsidian note with a background Codex worker.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "codex",
    "agents",
    "skills"
  ],
  "author": "Theo Stowell",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  }
}
